<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:h="http://xmlns.jcp.org/jsf/html"
      xmlns:f="http://xmlns.jcp.org/jsf/core"
      xmlns:p="http://primefaces.org/ui">

<h:head>
    <title>Cadastro de Alunos</title>
</h:head>

<h:body>
    <h:form id="frmAluno">
        <p:growl id="messages" showDetail="true" life="4000"/>

        <p:panel header="Cadastro de Aluno">
            <p:panelGrid columns="2">
                <p:outputLabel value="Nome:" />
                <p:inputText value="#{alunoBean.aluno.nome}" required="true" />

                <p:outputLabel value="CPF:" />
    			<p:inputMask id="cpf" 
                 value="#{alunoBean.aluno.cpf}" 
                 mask="999.999.999-99" 
                 required="true"
                 readonly="#{alunoBean.aluno.id != null}" />
            </p:panelGrid>

            <p:commandButton value="Salvar" 
                             action="#{alunoBean.salvar}" 
                             update="messages tabelaAlunos @form" 
                             process="@form" style="margin-top: 10px;"/>
        </p:panel>
        
        <p:panel header="Pesquisar Aluno" style="margin-bottom: 20px;">
		    <h:panelGrid columns="3">
		        <p:outputLabel value="Nome ou CPF:" />
		        <p:inputText value="#{alunoBean.termoBusca}" />
		        <p:commandButton value="Consultar" 
		                         action="#{alunoBean.pesquisar}" 
		                         update="@all" 
		                         process="@form" />
		    </h:panelGrid>
		</p:panel>

        <p:dataTable value="#{alunoBean.listaAlunos}" var="a" id="tabelaAlunos" style="margin-top: 10px;">
            <p:column headerText="ID">
                <h:outputText value="#{a.id}" />
            </p:column>
            <p:column headerText="Nome">
                <h:outputText value="#{a.nome}" />
            </p:column>
            <p:column headerText="CPF">
                <h:outputText value="#{a.cpf}" />
            </p:column>
            <p:column headerText="Ações">
                <p:commandButton value="Editar" 
                                 action="#{alunoBean.prepararEdicao(a)}"
                                 process="@this"
                                 update="@all" />
                
                <p:commandButton value="Excluir" 
                                 action="#{alunoBean.excluir(a)}" 
                                 process="@this"
                                 update="@form" style="margin-left: 10px;"/>
            </p:column>
        </p:dataTable>
    </h:form>
</h:body>
</html>